# Firebase Client Configuration for LumiSchool (Noesis Horizon)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Firebase Emulator Suite connection flag (set to 'true' for local testing)
VITE_USE_FIREBASE_EMULATOR=false
VITE_EMULATOR_HOST=localhost
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_STORAGE_EMULATOR_PORT=9199

VITE_FUNCTIONS_EMULATOR_PORT=5002
