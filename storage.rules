rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function member(schoolId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.status == 'active';
    }
    function teachingStaff(schoolId) {
      return member(schoolId) &&
        firestore.get(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.role in ['admin', 'teacher', 'dept_head'];
    }
    match /users/{uid}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.size < 20 * 1024 * 1024;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /schools/{schoolId}/{allPaths=**} {
      allow read: if member(schoolId);
      allow create, update: if teachingStaff(schoolId) && request.resource.size < 20 * 1024 * 1024;
      allow delete: if teachingStaff(schoolId);
    }
  }
}
