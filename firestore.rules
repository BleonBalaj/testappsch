rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSchoolCreator(schoolId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/schools/$(schoolId)) &&
        get(/databases/$(database)/documents/schools/$(schoolId)).data.creatorUid == request.auth.uid;
    }

    function isSchoolMember(schoolId) {
      return isSignedIn() && (
        isSchoolCreator(schoolId) || (
          exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.status == 'active'
        )
      );
    }

    function getMemberRole(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.role;
    }

    function isSchoolAdmin(schoolId) {
      return isSchoolCreator(schoolId) || (
        isSchoolMember(schoolId) && getMemberRole(schoolId) == 'admin'
      );
    }

    function isSchoolTeacherOrAdmin(schoolId) {
      return isSchoolAdmin(schoolId) || (
        isSchoolMember(schoolId) && (
          getMemberRole(schoolId) == 'teacher' ||
          getMemberRole(schoolId) == 'dept_head'
        )
      );
    }

    function canUseModule(schoolId, moduleId, teacherDefault, studentDefault) {
      return isSchoolAdmin(schoolId) || (
        isSchoolMember(schoolId) && (
          (getMemberRole(schoolId) != 'student' &&
            get(/databases/$(database)/documents/schools/$(schoolId)).data.get('rolePermissions', {}).get('teacher', {}).get(moduleId, teacherDefault) == true) ||
          (getMemberRole(schoolId) == 'student' &&
            get(/databases/$(database)/documents/schools/$(schoolId)).data.get('rolePermissions', {}).get('student', {}).get(moduleId, studentDefault) == true)
        )
      );
    }

    // users/{uid} profile: fields a signed-in user may write about themselves.
    // Only validates the keys being written, so older documents with extra
    // fields can still be edited.
    function validProfileValues(uid, keys) {
      let d = request.resource.data;
      return (!('uid' in keys) || d.uid == uid) &&
        (!('email' in keys) || (request.auth.token.email is string && d.email == request.auth.token.email.lower())) &&
        (!('displayName' in keys) || (d.displayName is string && d.displayName.size() <= 200)) &&
        (!('name' in keys) || (d.name is string && d.name.size() <= 200)) &&
        (!('photoURL' in keys) || d.photoURL == null || d.photoURL is string) &&
        (!('createdAt' in keys) || d.createdAt == request.time) &&
        (!('updatedAt' in keys) || d.updatedAt == request.time);
    }

    // A homeroom class such as 10A: grade level 0-12 (0 = Përgatitore), an
    // optional section, a display label and a homeroom teacher. No timetable.
    function validClassGroup(groupId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'gradeLevel', 'section', 'label', 'homeroomTeacherId', 'homeroomTeacherName', 'createdByUid']) &&
        d.keys().hasOnly(['id', 'gradeLevel', 'section', 'label', 'homeroomTeacherId', 'homeroomTeacherName', 'homeroomTeacherEmail', 'room', 'createdByUid', 'createdAt', 'updatedAt']) &&
        d.id == groupId &&
        d.gradeLevel is int && d.gradeLevel >= 0 && d.gradeLevel <= 12 &&
        d.section is string && d.section.size() <= 10 &&
        d.label is string && d.label.size() > 0 && d.label.size() <= 40 &&
        d.homeroomTeacherId is string && d.homeroomTeacherId.size() <= 128 &&
        d.homeroomTeacherName is string && d.homeroomTeacherName.size() <= 200 &&
        (!('homeroomTeacherEmail' in d) || (d.homeroomTeacherEmail is string && d.homeroomTeacherEmail.size() <= 320)) &&
        (!('room' in d) || (d.room is string && d.room.size() <= 100));
    }

    // Links on shared materials must be web links, never script URLs.
    function validResourceLink() {
      let d = request.resource.data;
      return !('url' in d) || d.url == '' || (d.url is string && d.url.size() <= 2048 && d.url.matches('(?i)https?://.+'));
    }

    // Search fields a student may refresh when renaming themselves.
    function validOwnStudentSearchFields() {
      let d = request.resource.data;
      return d.name is string && d.name.size() <= 200 &&
        (!('nameLower' in d) || (d.nameLower is string && d.nameLower.size() <= 200)) &&
        (!('searchTokens' in d) || (d.searchTokens is list && d.searchTokens.size() <= 250));
    }

    function conversationPath(schoolId, conversationId) {
      return /databases/$(database)/documents/schools/$(schoolId)/conversations/$(conversationId);
    }

    // memberIds lists the uids allowed in a conversation. Direct-message ids
    // are `dm_<uidA>_<uidB>`, so their member list must match the id.
    function validConversationMembers(conversationId, ids) {
      return ids is list && ids.size() >= 1 && ids.size() <= 500 && request.auth.uid in ids && (
        !conversationId.matches('dm_.*') ||
        (ids.size() == 2 && conversationId == 'dm_' + ids[0] + '_' + ids[1])
      );
    }

    function validOwnSchoolLink(schoolId, uid) {
      return isOwner(uid) &&
        request.resource.data.schoolId == schoolId &&
        exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(uid)) &&
        get(/databases/$(database)/documents/schools/$(schoolId)/members/$(uid)).data.status == 'active' &&
        request.resource.data.role == get(/databases/$(database)/documents/schools/$(schoolId)/members/$(uid)).data.role &&
        request.resource.data.status == 'active';
    }

    // AI generation quota is written only by the server. Users may inspect
    // their own usage, but cannot grant themselves more generations.
    match /lessonAiUsage/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
      match /requests/{requestId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ──────────────────────────────────────────────────────────
    // USERS COLLECTION & PRIVATE PREFERENCES
    // ──────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'name', 'photoURL', 'createdAt', 'updatedAt']) &&
        validProfileValues(uid, request.resource.data.keys());
      // uid and createdAt can be filled in once, never changed afterwards.
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'email', 'displayName', 'name', 'photoURL', 'createdAt', 'updatedAt']) &&
        validProfileValues(uid, request.resource.data.diff(resource.data).affectedKeys()) &&
        (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid) &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if false;

      // App-wide global preferences (Theme, animations, volume, etc.)
      match /preferences/app {
        allow read, write: if isOwner(uid);
      }

      // Per-user per-school preferences (Lesson-plan defaults, language, PDF options)
      match /schoolPreferences/{schoolId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }

      // School links projection for user's top dropdown
      match /schoolLinks/{schoolId} {
        allow read: if isOwner(uid);
        allow create, update: if validOwnSchoolLink(schoolId, uid) || isSchoolAdmin(schoolId);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // User personal mood tracking
      match /moods/{date} {
        allow read, write: if isOwner(uid);
      }

      // Personal dashboard data. Keep these paths explicit so this rule cannot
      // override the stricter schoolLinks membership checks above.
      match /studentTasks/{taskId} {
        allow read, write: if isOwner(uid);
      }
      match /dashboardNotes/{noteId} {
        allow read, write: if isOwner(uid);
      }
      // Personal bookmarks on a school's shared materials.
      match /resourceBookmarks/{schoolId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Server-only collections, written by Cloud Functions with the Admin SDK.
    // The platform admin page also reads through Cloud Functions, so no email
    // gets extra client access here.
    match /pendingInvitations/{invitationKey} {
      allow read, write: if false;
    }
    match /platformMaintenance/{docId} {
      allow read, write: if false;
    }

    // ──────────────────────────────────────────────────────────
    // SCHOOL TENANTS & SUBCOLLECTIONS
    // ──────────────────────────────────────────────────────────
    match /schools/{schoolId} {
      allow read: if isSchoolMember(schoolId);
      allow create: if isSignedIn() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isSchoolAdmin(schoolId) && request.resource.data.creatorUid == resource.data.creatorUid;
      allow delete: if false;

      // Roles
      match /roles/{roleId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolAdmin(schoolId);
      }

      // School Memberships (Authoritative source for roles)
      match /members/{memberUid} {
        allow read: if isSchoolMember(schoolId) || isOwner(memberUid);
        allow create: if isSchoolAdmin(schoolId);
        allow update: if isSchoolAdmin(schoolId) || (isOwner(memberUid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL']));
        allow delete: if isSchoolAdmin(schoolId) && request.auth.uid != memberUid;
      }

      // Staff directory
      match /staff/{staffId} {
        // Messaging and dashboard summaries also use the directory.
        allow read: if isSchoolMember(schoolId);
        // Initial school registration writes the creator's own staff record.
        // All later staff provisioning uses the callable account flow.
        allow create: if isSchoolCreator(schoolId) && isOwner(staffId) && request.resource.data.roleId == 'admin';
        allow delete: if isSchoolAdmin(schoolId) && request.auth.uid != staffId;
        allow update: if isSchoolAdmin(schoolId) || (isOwner(staffId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      }

      // Students directory
      match /students/{studentId} {
        // Messaging, leaderboard, and student dashboard share this roster.
        allow read: if isSchoolMember(schoolId);
        // Provision and remove accounts through the callable so Auth,
        // membership, school link, and directory stay in sync.
        allow create: if false;
        allow update: if isSchoolAdmin(schoolId) ||
          (isOwner(studentId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameLower', 'searchTokens']) && validOwnStudentSearchFields()) ||
          (isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'students', true, false) && canUseModule(schoolId, 'canEditDeleteStudents', true, false));
        allow delete: if false;
      }

      // Classes / Courses
      match /classes/{classId} {
        allow read: if canUseModule(schoolId, 'classes', true, true);
        allow create: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true);
        allow update: if isSchoolAdmin(schoolId) || (isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true) &&
          (canUseModule(schoolId, 'canEditDeleteClasses', true, false) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weights', 'categoryLabels', 'gradingSettings', 'curriculumStage', 'updatedAt'])));
        allow delete: if isSchoolAdmin(schoolId) || (isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true) && canUseModule(schoolId, 'canEditDeleteClasses', true, false));

        match /{allClassSubcollections=**} {
          allow read: if canUseModule(schoolId, 'classes', true, true);
          // Course materials carry links; the check passes for records without one.
          allow create, update: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true) && validResourceLink();
          allow delete: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true);
        }
      }

      // Homeroom classes. Every member reads them (student cards, rosters,
      // timetables); only school administrators create, edit or delete them.
      match /classGroups/{groupId} {
        allow read: if isSchoolMember(schoolId);
        allow create: if isSchoolAdmin(schoolId) && validClassGroup(groupId) && request.resource.data.createdByUid == request.auth.uid;
        allow update: if isSchoolAdmin(schoolId) && validClassGroup(groupId) && request.resource.data.createdByUid == resource.data.createdByUid;
        allow delete: if isSchoolAdmin(schoolId);
      }

      // Class enrollments
      match /enrollments/{enrollmentId} {
        allow read: if canUseModule(schoolId, 'classes', true, true);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true);
      }

      // Schedule & Timetable
      match /scheduleEntries/{entryId} {
        allow read: if canUseModule(schoolId, 'schedule', true, true);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'schedule', true, true);
      }

      // Events
      match /events/{eventId} {
        allow read: if canUseModule(schoolId, 'events', true, true);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'events', true, true);
      }

      // Assignments
      match /assignments/{assignmentId} {
        allow read: if canUseModule(schoolId, 'classes', true, true);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true);
      }

      // Grades
      match /grades/{gradeId} {
        allow read: if canUseModule(schoolId, 'classes', true, true);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true);
      }

      // Attendance records
      match /attendanceRecords/{recordId} {
        allow read: if canUseModule(schoolId, 'classes', true, true);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true);
      }

      // Lesson Plans (Author, Teachers, and Admins)
      match /lessonPlans/{planId} {
        allow read: if canUseModule(schoolId, 'lesson-plans', true, false);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'lesson-plans', true, false);
      }

      // Lesson Plan Templates
      match /templates/{templateId} {
        allow read: if canUseModule(schoolId, 'lesson-plans', true, false);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'lesson-plans', true, false);
      }

      // Lesson Reusable Entries
      match /reusableEntries/{entryId} {
        allow read: if canUseModule(schoolId, 'lesson-plans', true, false);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'lesson-plans', true, false);
      }

      // Topics
      match /topics/{topicId} {
        allow read: if canUseModule(schoolId, 'lesson-plans', true, false);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'lesson-plans', true, false);
      }

      // School curriculum mappings
      match /subjectMappings/{mappingId} {
        allow read: if canUseModule(schoolId, 'lesson-plans', true, false);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'lesson-plans', true, false);
      }
      match /stageMappings/{mappingId} {
        allow read: if canUseModule(schoolId, 'lesson-plans', true, false);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'lesson-plans', true, false);
      }

      // Resources
      match /resources/{resourceId} {
        allow read: if canUseModule(schoolId, 'resources', true, false);
        allow create, update: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'resources', true, false) && validResourceLink();
        allow delete: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'resources', true, false);
      }

      // Conversations & Messages (Real-time Chat): members only.
      match /conversations/{conversationId} {
        allow read: if canUseModule(schoolId, 'messages', true, true) &&
          request.auth.uid in resource.data.memberIds;
        allow create: if canUseModule(schoolId, 'messages', true, true) &&
          validConversationMembers(conversationId, request.resource.data.get('memberIds', null));
        // Members may update everything except who is in the conversation. A
        // direct message stored before memberIds existed may gain its list
        // from either participant, since the id proves who they are.
        allow update: if canUseModule(schoolId, 'messages', true, true) && (
          (request.auth.uid in resource.data.get('memberIds', []) &&
            request.resource.data.get('memberIds', null) == resource.data.get('memberIds', null)) ||
          (!('memberIds' in resource.data) && conversationId.matches('dm_.*') &&
            validConversationMembers(conversationId, request.resource.data.get('memberIds', null)))
        );
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if canUseModule(schoolId, 'messages', true, true) &&
            request.auth.uid in get(conversationPath(schoolId, conversationId)).data.get('memberIds', []);
          // getAfter lets the first message and its new conversation commit together.
          allow create: if canUseModule(schoolId, 'messages', true, true) &&
            request.auth.uid in getAfter(conversationPath(schoolId, conversationId)).data.get('memberIds', []) &&
            request.resource.data.senderUid == request.auth.uid;
          allow update: if canUseModule(schoolId, 'messages', true, true) &&
            request.auth.uid in get(conversationPath(schoolId, conversationId)).data.get('memberIds', []) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
          allow delete: if canUseModule(schoolId, 'messages', true, true) &&
            request.auth.uid in get(conversationPath(schoolId, conversationId)).data.get('memberIds', []) &&
            (resource.data.get('senderUid', '') == request.auth.uid || isSchoolTeacherOrAdmin(schoolId));
        }
      }

      // Tasks
      match /tasks/{taskId} {
        allow read, write: if canUseModule(schoolId, 'tasks', true, true);
      }

      // Mood entries: each member writes only their own `<uid>_<date>` entry.
      match /moodEntries/{entryId} {
        allow read: if canUseModule(schoolId, 'mood-insights', true, true) &&
          (resource.data.userId == request.auth.uid || isSchoolAdmin(schoolId));
        allow create, update: if canUseModule(schoolId, 'mood-insights', true, true) &&
          entryId.matches(request.auth.uid + '_.*') &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if isSchoolAdmin(schoolId) ||
          (canUseModule(schoolId, 'mood-insights', true, true) && resource.data.userId == request.auth.uid);
      }

      // Invitations
      match /invitations/{invitationId} {
        allow read: if isSchoolAdmin(schoolId) || (
          isSignedIn() && request.auth.token.email != null &&
          request.auth.token.email.lower() == resource.data.email.lower()
        );
        allow create, update, delete: if isSchoolAdmin(schoolId);
      }

      // Audit Events
      match /auditEvents/{eventId} {
        allow read: if isSchoolAdmin(schoolId);
        allow create: if isSchoolMember(schoolId);
        allow update, delete: if false; // Append-only audit log
      }
    }
  }
}
