rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSchoolCreator(schoolId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/schools/$(schoolId)) &&
        get(/databases/$(database)/documents/schools/$(schoolId)).data.creatorUid == request.auth.uid;
    }

    function isSchoolMember(schoolId) {
      return isSignedIn() && (
        isSchoolCreator(schoolId) || (
          exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.status == 'active'
        )
      );
    }

    function getMemberRole(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.role;
    }

    function isSchoolAdmin(schoolId) {
      return isSchoolCreator(schoolId) || (
        isSchoolMember(schoolId) && getMemberRole(schoolId) == 'admin'
      );
    }

    function isSchoolTeacherOrAdmin(schoolId) {
      return isSchoolAdmin(schoolId) || (
        isSchoolMember(schoolId) && (
          getMemberRole(schoolId) == 'teacher' ||
          getMemberRole(schoolId) == 'dept_head'
        )
      );
    }

    function canUseModule(schoolId, moduleId, teacherDefault, studentDefault) {
      return isSchoolAdmin(schoolId) || (
        isSchoolMember(schoolId) && (
          (getMemberRole(schoolId) != 'student' &&
            get(/databases/$(database)/documents/schools/$(schoolId)).data.get('rolePermissions', {}).get('teacher', {}).get(moduleId, teacherDefault) == true) ||
          (getMemberRole(schoolId) == 'student' &&
            get(/databases/$(database)/documents/schools/$(schoolId)).data.get('rolePermissions', {}).get('student', {}).get(moduleId, studentDefault) == true)
        )
      );
    }

    function validOwnSchoolLink(schoolId, uid) {
      return isOwner(uid) &&
        request.resource.data.schoolId == schoolId &&
        exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(uid)) &&
        get(/databases/$(database)/documents/schools/$(schoolId)/members/$(uid)).data.status == 'active' &&
        request.resource.data.role == get(/databases/$(database)/documents/schools/$(schoolId)/members/$(uid)).data.role &&
        request.resource.data.status == 'active';
    }

    // AI generation quota is written only by the server. Users may inspect
    // their own usage, but cannot grant themselves more generations.
    match /lessonAiUsage/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
      match /requests/{requestId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ──────────────────────────────────────────────────────────
    // USERS COLLECTION & PRIVATE PREFERENCES
    // ──────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;

      // App-wide global preferences (Theme, animations, volume, etc.)
      match /preferences/app {
        allow read, write: if isOwner(uid);
      }

      // Per-user per-school preferences (Lesson-plan defaults, language, PDF options)
      match /schoolPreferences/{schoolId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }

      // School links projection for user's top dropdown
      match /schoolLinks/{schoolId} {
        allow read: if isOwner(uid);
        allow create, update: if validOwnSchoolLink(schoolId, uid) || isSchoolAdmin(schoolId);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // User personal mood tracking
      match /moods/{date} {
        allow read, write: if isOwner(uid);
      }

      // Personal dashboard data. Keep these paths explicit so this rule cannot
      // override the stricter schoolLinks membership checks above.
      match /studentTasks/{taskId} {
        allow read, write: if isOwner(uid);
      }
      match /dashboardNotes/{noteId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ──────────────────────────────────────────────────────────
    // SCHOOL TENANTS & SUBCOLLECTIONS
    // ──────────────────────────────────────────────────────────
    match /schools/{schoolId} {
      allow read: if isSchoolMember(schoolId);
      allow create: if isSignedIn() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isSchoolAdmin(schoolId) && request.resource.data.creatorUid == resource.data.creatorUid;
      allow delete: if false;

      // Roles
      match /roles/{roleId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolAdmin(schoolId);
      }

      // School Memberships (Authoritative source for roles)
      match /members/{memberUid} {
        allow read: if isSchoolMember(schoolId) || isOwner(memberUid);
        allow create: if isSchoolAdmin(schoolId);
        allow update: if isSchoolAdmin(schoolId) || (isOwner(memberUid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL']));
        allow delete: if isSchoolAdmin(schoolId) && request.auth.uid != memberUid;
      }

      // Staff directory
      match /staff/{staffId} {
        // Messaging and dashboard summaries also use the directory.
        allow read: if isSchoolMember(schoolId);
        // Initial school registration writes the creator's own staff record.
        // All later staff provisioning uses the callable account flow.
        allow create: if isSchoolCreator(schoolId) && isOwner(staffId) && request.resource.data.roleId == 'admin';
        allow delete: if isSchoolAdmin(schoolId) && request.auth.uid != staffId;
        allow update: if isSchoolAdmin(schoolId) || (isOwner(staffId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      }

      // Students directory
      match /students/{studentId} {
        // Messaging, leaderboard, and student dashboard share this roster.
        allow read: if isSchoolMember(schoolId);
        // Provision and remove accounts through the callable so Auth,
        // membership, school link, and directory stay in sync.
        allow create: if false;
        allow update: if isSchoolAdmin(schoolId) || (isOwner(studentId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])) ||
          (isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'students', true, false) && canUseModule(schoolId, 'canEditDeleteStudents', true, false));
        allow delete: if false;
      }

      // Classes / Courses
      match /classes/{classId} {
        allow read: if canUseModule(schoolId, 'classes', true, true);
        allow create: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true);
        allow update: if isSchoolAdmin(schoolId) || (isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true) &&
          (canUseModule(schoolId, 'canEditDeleteClasses', true, false) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weights', 'categoryLabels', 'gradingSettings', 'curriculumStage', 'updatedAt'])));
        allow delete: if isSchoolAdmin(schoolId) || (isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true) && canUseModule(schoolId, 'canEditDeleteClasses', true, false));

        match /{allClassSubcollections=**} {
          allow read: if canUseModule(schoolId, 'classes', true, true);
          allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true);
        }
      }

      // Class enrollments
      match /enrollments/{enrollmentId} {
        allow read: if canUseModule(schoolId, 'classes', true, true);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true);
      }

      // Schedule & Timetable
      match /scheduleEntries/{entryId} {
        allow read: if canUseModule(schoolId, 'schedule', true, true);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'schedule', true, true);
      }

      // Events
      match /events/{eventId} {
        allow read: if canUseModule(schoolId, 'events', true, true);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'events', true, true);
      }

      // Assignments
      match /assignments/{assignmentId} {
        allow read: if canUseModule(schoolId, 'classes', true, true);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true);
      }

      // Grades
      match /grades/{gradeId} {
        allow read: if canUseModule(schoolId, 'classes', true, true);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true);
      }

      // Attendance records
      match /attendanceRecords/{recordId} {
        allow read: if canUseModule(schoolId, 'classes', true, true);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'classes', true, true);
      }

      // Lesson Plans (Author, Teachers, and Admins)
      match /lessonPlans/{planId} {
        allow read: if canUseModule(schoolId, 'lesson-plans', true, false);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'lesson-plans', true, false);
      }

      // Lesson Plan Templates
      match /templates/{templateId} {
        allow read: if canUseModule(schoolId, 'lesson-plans', true, false);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'lesson-plans', true, false);
      }

      // Lesson Reusable Entries
      match /reusableEntries/{entryId} {
        allow read: if canUseModule(schoolId, 'lesson-plans', true, false);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'lesson-plans', true, false);
      }

      // Topics
      match /topics/{topicId} {
        allow read: if canUseModule(schoolId, 'lesson-plans', true, false);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'lesson-plans', true, false);
      }

      // School curriculum mappings
      match /subjectMappings/{mappingId} {
        allow read: if canUseModule(schoolId, 'lesson-plans', true, false);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'lesson-plans', true, false);
      }
      match /stageMappings/{mappingId} {
        allow read: if canUseModule(schoolId, 'lesson-plans', true, false);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'lesson-plans', true, false);
      }

      // Resources
      match /resources/{resourceId} {
        allow read: if canUseModule(schoolId, 'resources', true, false);
        allow write: if isSchoolTeacherOrAdmin(schoolId) && canUseModule(schoolId, 'resources', true, false);
      }

      // Conversations & Messages (Real-time Chat)
      match /conversations/{conversationId} {
        allow read, write: if canUseModule(schoolId, 'messages', true, true);

        match /messages/{messageId} {
          allow read, write: if canUseModule(schoolId, 'messages', true, true);
        }
      }

      // Tasks
      match /tasks/{taskId} {
        allow read, write: if canUseModule(schoolId, 'tasks', true, true);
      }

      // Mood entries
      match /moodEntries/{entryId} {
        allow read, write: if canUseModule(schoolId, 'mood-insights', true, true);
      }

      // Invitations
      match /invitations/{invitationId} {
        allow read: if isSchoolAdmin(schoolId) || (
          isSignedIn() && request.auth.token.email != null &&
          request.auth.token.email.lower() == resource.data.email.lower()
        );
        allow create, update, delete: if isSchoolAdmin(schoolId);
      }

      // Audit Events
      match /auditEvents/{eventId} {
        allow read: if isSchoolAdmin(schoolId);
        allow create: if isSchoolMember(schoolId);
        allow update, delete: if false; // Append-only audit log
      }
    }
  }
}
